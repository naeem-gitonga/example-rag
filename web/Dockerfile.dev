# Development Dockerfile with hot-reloading support
# Build context should be project root to access shared/

# Stage 1: Dependencies
FROM node:22-alpine AS deps

WORKDIR /app

COPY web/package.json ./
RUN npm install

# Stage 2: Development server with hot-reload
FROM node:22-alpine AS dev

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY web/ .
COPY shared/ /shared/

EXPOSE 3000

# -H 0.0.0.0 allows access from any network interface (required for Docker)
# Hot-reloading works automatically with Next.js dev server
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "3000"]
